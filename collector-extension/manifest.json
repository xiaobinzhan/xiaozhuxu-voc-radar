{
  "manifest_version": 3,
  "name": "省心租 VOC 采集器",
  "version": "1.0.0",
  "description": "使用用户登录态采集小红书公开笔记，供本地 VOC 雷达使用",
  "permissions": ["storage", "alarms", "tabs", "activeTab"],
  "host_permissions": ["https://www.xiaohongshu.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/search_result*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "省心租采集器"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
